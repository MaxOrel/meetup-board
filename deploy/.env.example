# Шаблон файла /opt/meetup/.env на сервере. Скопируйте в .env и заполните.
# Файл .env в git не попадает и никогда не публикуется.

# Адрес сайта: свой домен (A-запись на IP сервера) или <ip-с-дефисами>.sslip.io
SITE_ADDRESS=meetup.example.com

# Где лежат образы: владелец/репозиторий на GitHub, строчными буквами
IMAGE_REPO=owner/repo

# Пароль базы и секрет токенов. Сгенерировать: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=

# Первый администратор (пароль — от 12 символов)
ADMIN_EMAIL=
ADMIN_PASSWORD=
